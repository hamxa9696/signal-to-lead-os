# ---- Copy to .env and fill in. See docs/SETUP.md for where each value comes from. ----

# §1 Postgres — local Docker default (docker-compose.yml). Later: Supabase connection string.
DATABASE_URL=postgres://stl:stl@localhost:5434/stl

# §2 Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# §3 Google service account — paste the WHOLE JSON key file on one line, in single quotes
GOOGLE_SERVICE_ACCOUNT_JSON=
# §4 GA4 numeric property id (Admin → Property details), e.g. 412345678
GA4_PROPERTY_ID=
# §5 Search Console property, e.g. sc-domain:renesistech.com  or  https://renesistech.com/
GSC_SITE_URL=

# §6 Payload CMS (renesistech.jp; the API is public read-only for published posts)
PAYLOAD_URL=https://renesistech.jp
PAYLOAD_API_KEY=
PAYLOAD_AUTH_COLLECTION=users
PAYLOAD_POSTS_COLLECTION=posts
# Category id for new AI articles (only "BlockChain" exists today; ask the developer to add one)
PAYLOAD_CATEGORY_ID=
# A media id to use as featured image until an editor picks a real one (every post has one)
PAYLOAD_PLACEHOLDER_IMAGE_ID=
# Category for lead-magnet landing pages (資料ダウンロード); the site shows the download form on it
PAYLOAD_RESOURCES_CATEGORY_ID=

# §7 Brevo (email delivery) — SMTP & API → API keys
BREVO_API_KEY=
# A sender address verified in Brevo (Senders & IP), e.g. info@renesistech.jp
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Renesis Tech

# §8 Make.com webhook (created in phase 4; leave empty for now)
MAKE_WEBHOOK_URL=

# §9 Supabase Storage — public bucket for lead-magnet PDFs (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override the PDF download base URL
LEAD_MAGNET_BASE_URL=

# PDF rendering uses your local Chrome
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
