# ---- Copy to .env and fill in. See docs/SETUP.md for where each value comes from. ----

# §1 Postgres — local Docker default (docker-compose.yml). Later: Supabase connection string.
DATABASE_URL=postgres://stl:stl@localhost:5434/stl

# §2 Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# §3 Google service account — paste the WHOLE JSON key file on one line, in single quotes
GOOGLE_SERVICE_ACCOUNT_JSON=
# §4 GA4 numeric property id (Admin → Property details), e.g. 412345678
GA4_PROPERTY_ID=
# §5 Search Console property, e.g. sc-domain:renesistech.com  or  https://renesistech.com/
GSC_SITE_URL=

# §6 Payload CMS
PAYLOAD_URL=
PAYLOAD_API_KEY=
PAYLOAD_AUTH_COLLECTION=users
PAYLOAD_POSTS_COLLECTION=posts

# §7 Brevo (email delivery) — SMTP & API → API keys
BREVO_API_KEY=

# §8 Make.com webhook (created in phase 4; leave empty for now)
MAKE_WEBHOOK_URL=
