{
  "name": "signal-to-lead-os",
  "version": "0.1.0",
  "private": true,
  "description": "Renesis Signal-to-Lead OS — automated content + inbound pipeline for the Japanese market (free-tier stack).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "typecheck": "tsc --noEmit",
    "db:up": "docker-compose up -d db",
    "db:down": "docker-compose down",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:psql": "docker-compose exec db psql -U stl -d stl",
    "job": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/jobs/run.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^9.15.0",
    "marked": "^18.1.2",
    "next": "^16.2.10",
    "postgres": "^3.4.5",
    "puppeteer-core": "^25.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  }
}
